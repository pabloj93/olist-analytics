# =============================================================================
# dbt-sql-agent-powerbi — environment variables
# =============================================================================
# Used by: dbt (profiles.yml env_var), ingestion/scripts/load_raw.py,
# and the chatbot backend (backend/app/config.py).

# --- Databricks workspace credentials -------------------------------------
# Find these in your Databricks Free Edition workspace:
#   HOST: settings -> workspace URL
#   TOKEN: user settings -> developer -> access tokens -> generate
#   HTTP_PATH: SQL Warehouse -> connection details -> HTTP Path
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# --- Unity Catalog naming -------------------------------------------------
# Run `SHOW CATALOGS` to list available catalogs.
DATABRICKS_CATALOG=analytics

# --- dbt schemas (one catalog, three schemas: raw / dev / prod) -----------
DBT_SCHEMA_RAW=olist_raw
DBT_SCHEMA_DEV=olist_dev
DBT_SCHEMA_PROD=olist_prod
DBT_TARGET=dev

# --- Chatbot backend: which schema the agent reads from -------------------
# Defaults to dev so local sessions iterate against the latest dbt build.
# In deploy we override this to olist_prod.
DATABRICKS_CHATBOT_SCHEMA=olist_dev

# --- LLM provider (Anthropic) ---------------------------------------------
# Required for the chatbot. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Observability (LangFuse) — optional ---------------------------------
# Leave empty to disable tracing. Get keys at https://cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent behavior -------------------------------------------------------
MAX_RETRIES=2

# --- App + CORS -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Frontend -------------------------------------------------------------
# Baked into the Vite build via VITE_* prefix. Points the SPA at the backend.
VITE_BACKEND_URL=http://localhost:8000
